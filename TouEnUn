    width: 400px; min-width: 320px; max-width: 60vw;
    background: #161b22; border: 1px solid #30363d;
    border-radius: 8px; padding: 10px;
    display: flex; flex-direction: column;
    gap: 10px; min-height: 0;
  }

  /* ═══════════════════════════════════════════
     SECTION SOURCES (EN HAUT)
     ═══════════════════════════════════════════ */
  .sources-section {
    flex-shrink: 0;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 10px;
    display: flex; flex-direction: column;
    gap: 8px;
  }
  .sources-header {
    display: flex; align-items: center; gap: 8px;
  }
  .sources-header .title {
    flex: 1; font-size: 0.9rem; font-weight: 700;
    color: #c9d1d9;
  }
  .add-source-btn {
    padding: 6px 12px; background: #238636;
    border: none; border-radius: 5px;
    color: white; font-weight: 600;
    cursor: pointer; font-size: 0.78rem;
  }
  .add-source-btn:hover { background: #2ea043; }

  .sources-select {
    width: 100%;
    padding: 10px 12px;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    font-size: 0.9rem;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    outline: none;
  }
  .sources-select:focus { border-color: #1f6feb; }
  .sources-select option { background: #161b22; color: #c9d1d9; }
  .sources-select optgroup { background: #0d1117; color: #8b949e; font-style: normal; font-weight: 700; }

  .sources-actions { display: flex; gap: 6px; }
  .src-btn {
    flex: 1;
    padding: 8px 10px;
    border: none; border-radius: 5px;
    cursor: pointer; font-weight: 600; font-size: 0.78rem;
  }
  .src-btn.load { background: #1f6feb; color: white; }
  .src-btn.load:hover:not(:disabled) { background: #388bfd; }
  .src-btn.load:disabled { opacity: 0.5; cursor: default; }
  .src-btn.edit { background: #21262d; color: #c9d1d9; border: 1px solid #30363d; }
  .src-btn.edit:hover { background: #30363d; }
  .src-btn.delete { background: #da3633; color: white; }
  .src-btn.delete:hover { background: #f85149; }

  /* ═══════════════════════════════════════════
     SECTION CHAÎNES (EN BAS, GRANDE)
     ═══════════════════════════════════════════ */
  .channels-section {
    flex: 1;
    display: flex; flex-direction: column;
    gap: 8px; min-height: 0;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 10px;
    overflow: hidden;
  }
  .channels-header {
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
  }
  .channels-header .title {
    font-size: 0.88rem; font-weight: 700;
    color: #c9d1d9; flex: 1;
    word-break: break-word;
  }
  .channels-header .info {
    font-size: 0.7rem; color: #8b949e;
    flex-shrink: 0;
  }

  /* Select des catégories */
  .category-select {
    width: 100%;
    padding: 10px 12px;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #c9d1d9;
    font-size: 0.9rem;
