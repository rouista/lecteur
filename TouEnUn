  .category-select option { background: #161b22; color: #c9d1d9; }

  .channels-search {
    width: 100%; padding: 8px 12px;
    background: #161b22; border: 1px solid #30363d;
    border-radius: 6px; color: #c9d1d9;
    font-size: 0.85rem; outline: none;
