<script>
/* =========================================================================
   SOURCES FIXES
   ========================================================================= */
const SOURCES = [
  { id: 'Server 1', name: 'Server1', type: 'auto', url: 'http://190.61.101.11:7050/playlist.m3u8' },
  { id: 'morocco', name: 'Maroc 🇲🇦', type: 'm3u', url: 'https://iptv-org.github.io/iptv/countries/ma.m3u' },
  { id: 'tunisia', name: 'Tunisie 🇹🇳', type: 'm3u', url: 'https://iptv-org.github.io/iptv/countries/tn.m3u' },
  { id: 'algeria', name: 'Algérie 🇩🇿', type: 'm3u', url: 'https://iptv-org.github.io/iptv/countries/dz.m3u' },
  { id: 'egypt',   name: 'Égypte 🇪🇬', type: 'm3u', url: 'https://iptv-org.github.io/iptv/countries/eg.m3u' },
  { id: 'france',  name: 'France 🇫🇷', type: 'm3u', url: 'https://iptv-org.github.io/iptv/countries/fr.m3u' },
  { id: 'cat_news',   name: '📰 Actualités',  type: 'm3u', url: 'https://iptv-org.github.io/iptv/categories/news.m3u' },
  { id: 'cat_sports', name: '⚽ Sport',        type: 'm3u', url: 'https://iptv-org.github.io/iptv/categories/sports.m3u' },
  { id: 'cat_movies', name: '🎬 Cinéma',       type: 'm3u', url: 'https://iptv-org.github.io/iptv/categories/movies.m3u' },
  { id: 'cat_music',  name: '🎵 Musique',      type: 'm3u', url: 'https://iptv-org.github.io/iptv/categories/music.m3u' },
  { id: 'cat_kids',   name: '🧒 Jeunesse',     type: 'm3u', url: 'https://iptv-org.github.io/iptv/categories/kids.m3u' },
  { id: 'cat_doc',    name: '📚 Documentaire', type: 'm3u', url: 'https://iptv-org.github.io/iptv/categories/documentary.m3u' }
];

const CONFIG = {
  FETCH_TIMEOUT_MS: 20000,
  STORAGE: { CUSTOM: 'iptv_custom_v8', UNLOCKED: 'iptv_unlocked_v8' }
};

/* =========================================================================
   ÉTAT
   ========================================================================= */
let customSources = [], editingSourceId = null, pendingPinSource = null;
let unlockedSources = new Set();
let hls = null, dashPlayer = null;

let activeSource = null;
let sourceChannels = [];
let sourceCategories = new Map();
let activeCategory = '__all__';
let searchQuery = '';
let currentUrl = '';

/* =========================================================================
   DOM
   ========================================================================= */
const $ = id => document.getElementById(id);
const sourcesSelect = $('sourcesSelect');
const sourceActions = $('sourceActions');
const loadSourceBtn = $('loadSourceBtn');
const editSourceBtn = $('editSourceBtn');
const deleteSourceBtn = $('deleteSourceBtn');
const channelsList = $('channelsList');
const channelsTitle = $('channelsTitle');
const channelsInfo = $('channelsInfo');
const categorySelect = $('categorySelect');
const channelSearch = $('channelSearch');
const video = $('video');
const videoWrapper = $('videoWrapper');
const urlDisplay = $('urlDisplay');
const statusBar = $('statusBar');
const modal = $('modal');
const pinModal = $('pinModal');
const pinInput = $('pinInput');
const pinError = $('pinError');
const mName = $('mName'), mType = $('mType'), mUrl = $('mUrl'),
      mJson = $('mJson'), mPin = $('mPin');
const mJsonLabel = $('mJsonLabel'), mPinLabel = $('mPinLabel'), mDelete = $('mDelete');

/* =========================================================================
   UTILS
   ========================================================================= */
const escapeHtml = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

function saveCustomSources() { try { localStorage.setItem(CONFIG.STORAGE.CUSTOM, JSON.stringify(customSources)); } catch {} }
function loadCustomSources() { try { const d = JSON.parse(localStorage.getItem(CONFIG.STORAGE.CUSTOM) || '[]'); return Array.isArray(d) ? d : []; } catch { return []; } }
function saveUnlocked() { try { sessionStorage.setItem(CONFIG.STORAGE.UNLOCKED, JSON.stringify([...unlockedSources])); } catch {} }
function loadUnlocked() { try { const d = JSON.parse(sessionStorage.getItem(CONFIG.STORAGE.UNLOCKED) || '[]'); return new Set(Array.isArray(d) ? d : []); } catch { return new Set(); } }

async function fetchWithTimeout(url, opts = {}) {
  const c = new AbortController();
  const t = setTimeout(() => c.abort(), CONFIG.FETCH_TIMEOUT_MS);
  try { return await fetch(url, { ...opts, signal: c.signal }); }
  finally { clearTimeout(t); }
}
function setStatus(msg, cls = '') { statusBar.textContent = msg; statusBar.className = 'status-bar ' + cls; }

function getAllSources() {
  return [...customSources, ...SOURCES];
}

/* =========================================================================
   DÉTECTION TYPE
   ========================================================================= */
function detectType(raw, url) {
  const t = raw.trimStart();
  if (t.startsWith('[') || t.startsWith('{')) return 'json';
  if (/^#EXTM3U/i.test(t) || /#EXTINF:/i.test(t)) return 'm3u';
  if (/\.list(?:[?#]|$)/i.test(url || '') && /https?:\/\//i.test(t)) return 'm3u';
  if (/\.m3u8?(?:[?#]|$)/i.test(url || '')) return 'm3u';
  return 'txt';
}

/* =========================================================================
   PARSEUR M3U UNIVERSEL
   ========================================================================= */
function parseM3U(text) {
  const lines = text.replace(/^\uFEFF/, '').split(/\r?\n/);
  const out = [];
  let pending = null;

  const parseAttrs = (str) => {
    const attrs = {};
    const re = /([a-zA-Z0-9_-]+)\s*=\s*("([^"]*)"|'([^']*)'|([^,\s]+))/g;
    let m;
    while ((m = re.exec(str)) !== null) {
      attrs[m[1].toLowerCase()] = m[3] ?? m[4] ?? m[5] ?? '';
    }
    return attrs;
  };

  for (let rawLine of lines) {
    const line = rawLine.trim();
    if (!line) continue;

    if (line.startsWith('#EXTINF:')) {
      const body = line.slice(8);
      let title = '', attrsPart = body;
      let inQuote = false, lastComma = -1;
      for (let i = 0; i < body.length; i++) {
        const ch = body[i];
        if (ch === '"') inQuote = !inQuote;
        else if (ch === ',' && !inQuote) lastComma = i;
      }
      if (lastComma >= 0) {
        attrsPart = body.slice(0, lastComma);
        title = body.slice(lastComma + 1).trim();
      }
      const attrs = parseAttrs(attrsPart);
      pending = {
        name: title || attrs['tvg-name'] || '',
        country: attrs['tvg-country'] || '',
        categories: attrs['group-title'] ? [attrs['group-title']] : [],
        logo: attrs['tvg-logo'] || ''
      };
      continue;
    }

    if (line.startsWith('#') && !line.startsWith('#EXTINF')) continue;

    let name = '', url = '';
    if (/^https?:\/\//i.test(line)) {
      url = line;
    } else {
      const idx = line.lastIndexOf(',');
      if (idx > 0) {
        const candidate = line.slice(idx + 1).trim();
        if (/^https?:\/\//i.test(candidate)) {
          name = line.slice(0, idx).trim();
          url = candidate;
        }
      }
    }
    if (!url) continue;

    out.push({
      name: pending?.name || name || 'Sans nom',
      url,
      country: pending?.country || '',
      categories: pending?.categories?.length ? pending.categories : ['Sans catégorie'],
      logo: pending?.logo || ''
    });
    pending = null;
  }
  return out;
}

function normalizeCategories(c) {
  if (Array.isArray(c.categories)) return c.categories.map(s => String(s).trim()).filter(Boolean);
  if (typeof c.categories === 'string') return c.categories.split(/[,;|]/).map(s => s.trim()).filter(Boolean);
  if (c.group) return [String(c.group).trim()];
  if (c.genre) return [String(c.genre).trim()];
  return [];
}

/* =========================================================================
   RENDU : SELECT SOURCES
   ========================================================================= */
function renderSourcesList() {
  const all = getAllSources();
  sourcesSelect.innerHTML = '';

  const placeholder = document.createElement('option');
  placeholder.value = '';
  placeholder.textContent = all.length ? '— Choisir une source —' : 'Aucune source';
  sourcesSelect.appendChild(placeholder);

  const customs = all.filter(s => s._custom);
  const fixes = all.filter(s => !s._custom);

  if (customs.length) {
    const group = document.createElement('optgroup');
    group.label = '⭐ Mes sources';
    customs.forEach(src => {
      const opt = document.createElement('option');
      opt.value = src.id;
      const lock = src.pin && !unlockedSources.has(src.id) ? '🔒 ' : '';
      opt.textContent = `${lock}${src.name}`;
      group.appendChild(opt);
    });
    sourcesSelect.appendChild(group);
  }

  if (fixes.length) {
    const group = document.createElement('optgroup');
    group.label = '📡 Sources fixes';
    fixes.forEach(src => {
      const opt = document.createElement('option');
      opt.value = src.id;
      const lock = src.pin && !unlockedSources.has(src.id) ? '🔒 ' : '';
      opt.textContent = `${lock}${src.name}`;
      group.appendChild(opt);
    });
    sourcesSelect.appendChild(group);
  }

  if (activeSource) sourcesSelect.value = activeSource.id;
  updateSourceActions();
}

function updateSourceActions() {
  const id = sourcesSelect.value;
  if (!id) { sourceActions.style.display = 'none'; return; }

  const src = getAllSources().find(s => s.id === id);
  if (!src) { sourceActions.style.display = 'none'; return; }

  sourceActions.style.display = 'flex';

  const isActive = activeSource && activeSource.id === id;
  loadSourceBtn.textContent = isActive ? '✓ Chargée' : '▶ Charger';
  loadSourceBtn.disabled = isActive;

  const isCustom = !!src._custom;
  editSourceBtn.style.display = isCustom ? 'block' : 'none';
  deleteSourceBtn.style.display = isCustom ? 'block' : 'none';
}

sourcesSelect.addEventListener('change', updateSourceActions);

loadSourceBtn.onclick = () => {
  const id = sourcesSelect.value;
  if (!id) return;
  const src = getAllSources().find(s => s.id === id);
  if (src) selectSource(src);
};

editSourceBtn.onclick = () => {
  const id = sourcesSelect.value;
  if (id) openModal(id);
};

deleteSourceBtn.onclick = () => {
  const id = sourcesSelect.value;
  if (id) deleteSource(id);
};

/* =========================================================================
   SÉLECTION SOURCE
   ========================================================================= */
function selectSource(src) {
  if (src.pin && !unlockedSources.has(src.id)) {
    pendingPinSource = src;
    pinInput.value = ''; pinError.style.display = 'none';
    pinModal.classList.add('open'); pinInput.focus();
    return;
  }
  loadSource(src);
}

async function loadSource(src) {
  activeSource = src;
  searchQuery = '';
  channelSearch.value = '';
  activeCategory = '__all__';
  sourceChannels = [];
  sourceCategories = new Map();

  channelsTitle.textContent = `📺 ${src.name}`;
  channelsInfo.textContent = 'Chargement...';
  channelsList.innerHTML = '<div class="empty">Chargement en cours...</div>';
  channelSearch.style.display = 'none';
  categorySelect.style.display = 'none';

  renderSourcesList();

  if (src.type === 'web') {
    channelsList.innerHTML = `
      <div class="empty" style="padding:24px;">
        🌐 Source web externe<br><br>
        <a href="${src.url}" target="_blank" rel="noopener"
           style="color:#58a6ff;font-weight:600;text-decoration:none;font-size:1rem;">
           Ouvrir ${escapeHtml(src.name)} ↗
        </a>
      </div>`;
    channelsInfo.textContent = 'Lien externe';
    setStatus(`Source web : ${src.name}`, 'warn');
    return;
  }

  try {
    let raw = null;
    if (src.json && src.json.trim()) raw = src.json.trim();
    else if (src.url) {
      const r = await fetchWithTimeout(src.url, { mode: 'cors' });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      raw = await r.text();
    }
    if (!raw) throw new Error('Contenu vide.');

    let detected = src.type || 'auto';
    if (detected === 'auto') detected = detectType(raw, src.url);

    let list = [];
    let hasCategories = false;

    if (detected === 'json') {
      const data = JSON.parse(raw);
      list = Array.isArray(data) ? data : (data.channels || data.streams || data.items || data.list || []);
    } else if (detected === 'm3u') {
      list = parseM3U(raw);
      hasCategories = true; // M3U → filtre catégories
    } else {
      list = raw.split(/\r?\n/).map(l => l.trim())
        .filter(l => l && !l.startsWith('#'))
        .map((url, i) => ({ name: `Chaîne ${i + 1}`, url }));
    }

    list = list.map((c, i) => ({
      name: c.name || c.title || c.channel || c.nom || `Chaîne ${i + 1}`,
      url: c.url || c.link || c.stream || c.src || c.lien || '',
      country: c.country || c.pays || '',
      categories: normalizeCategories(c),
      logo: c.logo || ''
    })).filter(c => c.url);

    sourceChannels = list;
    sourceCategories = new Map();

    list.forEach(ch => {
      const cat = (ch.categories && ch.categories[0]) || 'Sans catégorie';
      if (!sourceCategories.has(cat)) sourceCategories.set(cat, []);
      sourceCategories.get(cat).push(ch);
    });

    channelsTitle.textContent = `📺 ${src.name}`;
    channelsInfo.textContent = `${list.length} chaînes`;

    // Afficher select catégories UNIQUEMENT pour M3U
    if (hasCategories && sourceCategories.size > 1) {
      renderCategorySelect();
      categorySelect.style.display = 'block';
    } else {
      categorySelect.style.display = 'none';
    }

    channelSearch.style.display = list.length > 15 ? 'block' : 'none';

    renderChannelsList();
    setStatus(`${list.length} chaînes chargées depuis "${src.name}".`, 'ok');
  } catch (e) {
    console.error(e);
    setStatus('Erreur : ' + e.message, 'error');
    channelsList.innerHTML = `<div class="empty" style="color:#f85149;">Erreur : ${escapeHtml(e.message)}</div>`;
    channelsInfo.textContent = 'Erreur';
  }
}

/* =========================================================================
   SELECT CATÉGORIES
   ========================================================================= */
function renderCategorySelect() {
  categorySelect.innerHTML = '';

  // Option "Toutes"
  const allOpt = document.createElement('option');
  allOpt.value = '__all__';
  allOpt.textContent = `📁 Toutes les catégories (${sourceChannels.length})`;
  categorySelect.appendChild(allOpt);

  // Catégories triées
  const cats = [...sourceCategories.keys()].sort((a, b) => {
    if (a === 'Sans catégorie') return 1;
    if (b === 'Sans catégorie') return -1;
    return a.localeCompare(b);
  });

  cats.forEach(cat => {
    const opt = document.createElement('option');
    opt.value = cat;
    opt.textContent = `📁 ${cat} (${sourceCategories.get(cat).length})`;
    categorySelect.appendChild(opt);
  });

  categorySelect.value = activeCategory;
}

categorySelect.addEventListener('change', e => {
  activeCategory = e.target.value;
  renderChannelsList();
});

/* =========================================================================
   LISTE DES CHAÎNES (avec scroll)
   ========================================================================= */
function renderChannelsList() {
  channelsList.innerHTML = '';

  let displayList = [];
  if (activeCategory === '__all__') {
    displayList = sourceChannels;
  } else {
    displayList = sourceCategories.get(activeCategory) || [];
  }

  // Filtre recherche
  const q = searchQuery.toLowerCase().trim();
  if (q) {
    displayList = displayList.filter(ch => ch.name.toLowerCase().includes(q));
  }

  if (!displayList.length) {
    channelsList.innerHTML = '<div class="empty">Aucune chaîne.</div>';
    return;
  }

  displayList.forEach(ch => {
    const d = document.createElement('div');
    d.className = 'channel-item';
    const flag = ch.country
      ? `<img class="flag" src="https://flagcdn.com/w20/${ch.country.toLowerCase()}.png" onerror="this.style.display='none'">`
      : '';
    const catLabel = ch.categories && ch.categories.length ? ch.categories.join(', ') : '';
    d.innerHTML = `${flag}<div class="info">
      <div class="cname">${escapeHtml(ch.name)}</div>
      ${catLabel ? `<div class="cmeta">${escapeHtml(catLabel)}</div>` : ''}
    </div>`;
    d.onclick = () => {
      document.querySelectorAll('.channel-item').forEach(e => e.classList.remove('active'));
      d.classList.add('active');
      playStream(ch.url, ch.name);
    };
    channelsList.appendChild(d);
  });
}

channelSearch.addEventListener('input', e => {
  searchQuery = e.target.value;
  renderChannelsList();
});

/* =========================================================================
   SUPPRESSION SOURCE
   ========================================================================= */
function deleteSource(id) {
  if (!confirm('Supprimer cette source ?')) return;
  customSources = customSources.filter(s => s.id !== id);
  saveCustomSources();
  if (activeSource && activeSource.id === id) {
    activeSource = null;
    sourceChannels = [];
    sourceCategories = new Map();
    channelsList.innerHTML = '<div class="empty">Choisissez une source ci-dessus.</div>';
    channelsTitle.textContent = '📺 Chaînes';
    channelsInfo.textContent = 'Sélectionnez une source';
    channelSearch.style.display = 'none';
    categorySelect.style.display = 'none';
  }
  renderSourcesList();
  setStatus('Source supprimée.');
}

/* =========================================================================
   LECTEUR UNIVERSEL
   =========================================================================
   Gère : HLS (.m3u8 partout), DASH (.mpd), MP4/WebM/OGG/MKV/MP3/...
   Détection par Content-Type + extension + fallback natif.
   ========================================================================= */
function destroyPlayers() {
  if (hls) { try { hls.detachMedia(); hls.destroy(); } catch {} hls = null; }
  if (dashPlayer) { try { dashPlayer.reset(); } catch {} dashPlayer = null; }
  video.pause();
  video.removeAttribute('src');
  video.load();
}

async function playStream(url, name) {
  currentUrl = url;
  urlDisplay.textContent = url || 'Aucun flux';
  setStatus(`Lecture : ${name}...`);

  destroyPlayers();

  if (!url) { setStatus('URL vide.', 'error'); return; }

  const lower = url.split('#')[0].toLowerCase();
  const cleanPath = lower.split('?')[0];

  // --- 1. HLS (m3u8, y compris avec query string) ---
  if (lower.includes('.m3u8')) {
    if (window.Hls && Hls.isSupported()) {
      hls = new Hls({ enableWorker: true, lowLatencyMode: true });
      hls.loadSource(url);
      hls.attachMedia(video);
      hls.on(Hls.Events.MANIFEST_PARSED, () => {
        video.play().catch(() => setStatus('Cliquez sur Lecture.', 'warn'));
        setStatus(`Lecture HLS : ${name}`, 'ok');
      });
      hls.on(Hls.Events.ERROR, (_, data) => {
        if (data.fatal) {
          setStatus(`Erreur HLS : ${data.details}`, 'error');
          try { hls.destroy(); } catch {}
          hls = null;
          // Fallback : essayer lecture native
          tryNativePlayback(url);
        }
      });
      return;
    }
    if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = url;
      video.play()
        .then(() => setStatus(`Lecture HLS natif : ${name}`, 'ok'))
        .catch(() => setStatus('Cliquez sur Lecture.', 'warn'));
      return;
    }
    setStatus('HLS non supporté par ce navigateur.', 'error');
    return;
  }

  // --- 2. DASH (mpd) ---
  if (cleanPath.endsWith('.mpd') || lower.includes('.mpd')) {
    if (window.dashjs) {
      dashPlayer = dashjs.MediaPlayer().create();
      dashPlayer.initialize(video, url, true);
      dashPlayer.on('streamInitialized', () => setStatus(`Lecture DASH : ${name}`, 'ok'));
      dashPlayer.on('error', () => setStatus('Erreur DASH', 'error'));
      return;
    }
    setStatus('DASH non chargé.', 'error');
    return;
  }

  // --- 3. Formats natifs (MP4, WebM, OGG, MKV, MP3, AAC, M4V, etc.) ---
  tryNativePlayback(url);
}

function tryNativePlayback(url) {
  // Détection par Content-Type via HEAD (si CORS le permet), sinon direct
  video.src = url;
  video.load();

  video.onloadedmetadata = () => {
    setStatus(`Lecture : ${video.videoWidth}x${video.videoHeight}`, 'ok');
  };
  video.onerror = () => {
    setStatus('Impossible de lire ce flux (format non supporté ou accès refusé).', 'error');
  };
  video.onplaying = () => {
    setStatus('Lecture en cours.', 'ok');
  };

  video.play().catch(() => setStatus('Cliquez sur Lecture.', 'warn'));
}

/* =========================================================================
   BOUTONS PLAYER
   ========================================================================= */
$('fullscreenBtn').onclick = () => {
  if (videoWrapper.requestFullscreen) {
    videoWrapper.requestFullscreen().catch(() => {});
  } else if (videoWrapper.webkitRequestFullscreen) {
    videoWrapper.webkitRequestFullscreen();
  } else if (video.webkitEnterFullscreen) {
    video.webkitEnterFullscreen();
  }
};

$('stopBtn').onclick = () => {
  destroyPlayers();
  urlDisplay.textContent = 'Aucun flux sélectionné';
  setStatus('Lecture arrêtée.');
  document.querySelectorAll('.channel-item').forEach(e => e.classList.remove('active'));
};

$('copyUrlBtn').onclick = async () => {
  if (!currentUrl) { setStatus('Aucune URL à copier.', 'warn'); return; }
  try {
    await navigator.clipboard.writeText(currentUrl);
    setStatus('URL copiée.', 'ok');
  } catch {
    setStatus('Copie impossible.', 'error');
  }
};

$('openUrlBtn').onclick = () => {
  if (!currentUrl) { setStatus('Aucune URL à ouvrir.', 'warn'); return; }
  window.open(currentUrl, '_blank', 'noopener');
};

/* =========================================================================
   MODAL SOURCE
   ========================================================================= */
$('addSourceBtn').onclick = () => openModal(null);

function updateJsonVisibility() {
  const v = mType.value;
  mJsonLabel.style.display = (v === 'auto' || v === 'm3u' || v === 'json' || v === 'txt') ? 'flex' : 'none';
}
mType.onchange = updateJsonVisibility;

function openModal(id) {
  editingSourceId = id;
  mPinLabel.style.display = 'flex';
  if (id) {
    const s = customSources.find(x => x.id === id);
    if (!s) return;
    $('modalTitle').textContent = 'Modifier';
    mName.value = s.name; mType.value = s.type || 'auto'; mUrl.value = s.url || '';
    mJson.value = s.json || ''; mPin.value = s.pin || '';
    mDelete.style.display = 'inline-block';
  } else {
    $('modalTitle').textContent = 'Ajouter';
    mName.value = ''; mType.value = 'auto'; mUrl.value = ''; mJson.value = ''; mPin.value = '';
    mDelete.style.display = 'none';
  }
  updateJsonVisibility();
  modal.classList.add('open');
}
$('mCancel').onclick = () => modal.classList.remove('open');
modal.onclick = e => { if (e.target === modal) modal.classList.remove('open'); };

$('mSave').onclick = () => {
  const name = mName.value.trim(), type = mType.value,
        url = mUrl.value.trim(), json = mJson.value.trim(), pin = mPin.value.trim();
  if (!name) return alert('Nom requis.');
  if (!url && !json) return alert('URL ou contenu requis.');
  if (pin && !/^\d{4}$/.test(pin)) return alert('PIN doit être 4 chiffres.');

  if (editingSourceId) {
    const s = customSources.find(x => x.id === editingSourceId);
    Object.assign(s, { name, type, url, json, pin });
  } else {
    customSources.push({ id: 'src_' + Date.now(), name, type, url, json, pin, _custom: true });
  }
  saveCustomSources();
  modal.classList.remove('open');
  renderSourcesList();
  setStatus('Source enregistrée.', 'ok');
};

mDelete.onclick = () => {
  if (!editingSourceId) return;
  deleteSource(editingSourceId);
  modal.classList.remove('open');
};

/* =========================================================================
   PIN
   ========================================================================= */
function closePinModal() { pinModal.classList.remove('open'); pendingPinSource = null; pinInput.value = ''; pinError.style.display = 'none'; }
$('pinCancel').onclick = closePinModal;
pinModal.onclick = e => { if (e.target === pinModal) closePinModal(); };

function validatePin() {
  if (!pendingPinSource) return;
  if (pinInput.value === pendingPinSource.pin) {
    unlockedSources.add(pendingPinSource.id);
    saveUnlocked();
    const src = pendingPinSource;
    closePinModal();
    loadSource(src);
  } else {
    pinError.style.display = 'block';
    pinInput.value = '';
    pinInput.focus();
  }
}
$('pinOk').onclick = validatePin;
pinInput.addEventListener('keydown', e => { if (e.key === 'Enter') validatePin(); });

/* =========================================================================
   INIT
   ========================================================================= */
customSources = loadCustomSources();
unlockedSources = loadUnlocked();
renderSourcesList();
</script>
