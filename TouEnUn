<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Media Player — Tout-en-un</title>
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
<script src="https://cdn.dashjs.org/latest/modern/umd/dash.all.min.js"></script>
<style>
  * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
  body { margin: 0; padding: 10px; background: #0d1117; color: #c9d1d9; height: 100vh; display: flex; flex-direction: column; }
  .app { display: flex; gap: 10px; flex: 1; min-height: 0; }

  /* ═══════════════════════════════════════════
     SIDEBAR
     ═══════════════════════════════════════════ */
